---
// On the unprefixed (English) pages only: sends visitors who prefer Chinese to
// the /zh/ page before first paint. See zhRedirectTarget.
import { LOCALE_STORAGE_KEY } from '@/shared/i18n'
import { zhRedirectTarget } from '@/shared/i18n/detect'

const script = `;(function () {
  var stored = null
  try { stored = localStorage.getItem(${JSON.stringify(LOCALE_STORAGE_KEY)}) } catch (e) {}
  var languages = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || '']
  var target = (${zhRedirectTarget.toString()})(location.pathname, stored, languages)
  if (target) location.replace(target + location.search + location.hash)
})()`
---

<script is:inline set:html={script} />

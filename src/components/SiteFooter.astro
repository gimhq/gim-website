---
import type { Copy } from '@/shared/i18n'
import { GITHUB_ORG_URL } from '@/features/landing/links'
import { BrandIcon } from '@/shared/components/brand-mark'

interface Props {
  copy: Copy
}

const { copy } = Astro.props
---

<footer class="mx-auto mt-24 max-w-[1120px] px-gutter">
  <div class="flex flex-wrap items-center gap-x-4 gap-y-2 border-t py-8 text-[13px] text-muted-foreground">
    <BrandIcon className="size-5" />
    <span>gim · {copy.footer.tagline}</span>
    <span class="min-w-3 flex-1"></span>
    <a href={GITHUB_ORG_URL}>github.com/gimhq</a>
  </div>
</footer>

---
// Starlight renders its own <head>, so the site's additions are appended here.
import Default from '@astrojs/starlight/components/Head.astro'
import FontPreload from '@/components/FontPreload.astro'
import LocaleScript from '@/components/LocaleScript.astro'

const { locale } = Astro.locals.starlightRoute
---

{locale === undefined && <LocaleScript />}
<Default><slot /></Default>
<FontPreload />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

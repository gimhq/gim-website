---
import type { Copy, LocaleCode } from '@/shared/i18n'
import FontPreload from '@/components/FontPreload.astro'
import LocaleScript from '@/components/LocaleScript.astro'
import SiteFooter from '@/components/SiteFooter.astro'
import SiteHeader from '@/components/SiteHeader.astro'
import ThemeScript from '@/components/ThemeScript.astro'
import { copyFor, localePaths, locales } from '@/shared/i18n'
import '@/styles/global.css'

interface Props {
  locale: LocaleCode
  /** Root-relative path of this page without the locale prefix, e.g. `download/`. */
  path: string
  title: string
  description: string
}

const { locale, path, title, description } = Astro.props
const copy: Copy = copyFor(locale)
const paths = localePaths(path)
const site = Astro.site!
---

<!doctype html>
<html lang={copy.meta.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {locale === 'en' && <LocaleScript />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(paths[locale], site)} />
    {locales.map(l => (
      <link rel="alternate" hreflang={copyFor(l.code).meta.htmlLang} href={new URL(paths[l.code], site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(paths.en, site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(paths[locale], site)} />
    <FontPreload />
    <ThemeScript />
  </head>
  <body class="relative min-h-dvh">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[560px] bg-[radial-gradient(60%_100%_at_50%_0%,color-mix(in_srgb,var(--brand)_16%,transparent),transparent)]"
    >
    </div>
    <SiteHeader copy={copy} locale={locale} paths={paths} />
    <main class="mx-auto max-w-[1120px] px-gutter">
      <slot />
    </main>
    <SiteFooter copy={copy} />
  </body>
</html>
